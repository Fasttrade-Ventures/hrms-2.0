{
  "name": "hrms",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:payroll-integration": "PAYROLL_INTEGRATION=1 vitest run tests/integration/payroll-lifecycle.test.ts",
    "legacy-import": "tsx scripts/legacy-import/src/index.ts",
    "bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "seed-role-accounts": "tsx scripts/seed-role-accounts.ts",
    "seed-org-catalogs": "tsx scripts/seed-org-catalogs.ts",
    "seed-payroll-rules": "tsx scripts/seed-payroll-rules.ts",
    "seed-demo-data": "tsx scripts/seed-demo-data.ts",
    "upgrade-standalone-tier": "tsx scripts/upgrade-standalone-tier.ts",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "payroll:payslip-email": "tsx scripts/run-payslip-email-job.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
