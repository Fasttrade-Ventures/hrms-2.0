# Deployment
DEPLOYMENT_MODE=standalone
# Entitlements (standalone). Default if unset: enterprise (all modules).
# Use core|professional for narrower packaging; MODULE_OVERRIDES for JSON toggles.
PRODUCT_TIER=enterprise
# MODULE_OVERRIDES={"recruitment":false}
DEFAULT_ORGANIZATION_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server only)
SUPABASE_SERVICE_ROLE_KEY=

# Cron (server only — Vercel Cron)
CRON_SECRET=

# SaaS billing (Billplz) — only when DEPLOYMENT_MODE=saas and BILLING_ENABLED=true
BILLING_ENABLED=false
BILLPLZ_API_KEY=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_COLLECTION_CORE=
BILLPLZ_COLLECTION_PROFESSIONAL=
BILLPLZ_COLLECTION_ENTERPRISE=
BILLPLZ_API_BASE=https://www.billplz.com/api
BILLING_TRIAL_DAYS=14
BILLING_PAST_DUE_GRACE_DAYS=7
BILLING_SIGNUP_MODE=trial_first

# Cloudflare R2 (server only) — required for document/payslip storage in production
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
# Local only: ALLOW_R2_STUB=1 lets notification outbox use StubR2StorageAdapter when R2 env is missing.
# ALLOW_R2_STUB=0 forces fail-closed even in development.
# ALLOW_R2_STUB=

# Mail (server only)
RESEND_API_KEY=
MAIL_FROM=
